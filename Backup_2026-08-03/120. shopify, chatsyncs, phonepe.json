{"updatedAt":"2026-08-02T13:36:54.706Z","createdAt":"2026-08-02T08:14:23.997Z","id":"nSeBvClFPcE1JlPO","name":"120. shopify, chatsyncs, phonepe","active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"chatsyncs-msg","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-112,112],"id":"5901613c-31fd-4900-8a32-c4d29c882cc8","name":"Webhook","webhookId":"d9cf83e8-0484-4c64-a807-3d8013e972b5"},{"parameters":{"jsCode":"const body = $input.first().json.body;\nconst rawText = body.user_message || '';\nconst chatId = body.chat_id || '';\n\n// Extract product URL\nconst urlMatch = rawText.match(/https?:\\/\\/[^\\s]+/);\nconst productUrl = urlMatch ? urlMatch[0] : '';\n\n// Extract handle from URL (segment after /products/)\nlet handle = '';\nif (productUrl.includes('/products/')) {\n  handle = productUrl.split('/products/')[1].split(/[?&#]/)[0].trim();\n}\n\n// Extract variant name from parentheses on the product line\nconst variantMatch = rawText.match(/\\(([^)]+)\\)\\s*(?:\\r?\\n|$)/);\nconst variantTitle = variantMatch ? variantMatch[1].trim() : '';\n\nreturn [{\n  json: {\n    chatId,\n    handle,\n    variantTitle,\n    rawText\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[240,-144],"id":"1e0b1fa0-473f-4844-ac1a-10d06e5938ac","name":"Parse WhatsApp Message"},{"parameters":{"method":"POST","url":"https://YOUR-STORE.myshopify.com/admin/api/2025-01/graphql.json","authentication":"predefinedCredentialType","nodeCredentialType":"shopifyApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ query: `query getProduct($handle: String!) { productByHandle(handle: $handle) { id title variants(first: 20) { edges { node { id title inventoryQuantity availableForSale } } } } }`, variables: { handle: $json.handle } }) }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[544,-144],"id":"9caac06d-5846-4d49-91f0-565a3ff7b8fc","name":"Get product from Shopify","disabled":true},{"parameters":{"jsCode":"const parsed = $('Parse WhatsApp Message').first().json;\nconst response = $input.first().json;\n\nconst product = response.data && response.data.productByHandle;\n\nlet replyMessage;\nif (!product) {\n  replyMessage = \"Sorry, we couldn't find that product. Please share the product link again or contact us directly.\";\n} else {\n  const variants = product.variants.edges.map(e => e.node);\n  let variant = variants.find(v => v.title.toLowerCase() === parsed.variantTitle.toLowerCase());\n  if (!variant) variant = variants[0];\n\n  const inStock = variant.availableForSale && variant.inventoryQuantity > 0;\n\n  if (inStock) {\n    replyMessage = `Good news! \"${product.title}\" (${variant.title}) is in stock.\\n\\nWe'll get your order confirmed shortly. Would you like to proceed with payment?`;\n  } else {\n    replyMessage = `Sorry, \"${product.title}\" (${variant.title}) is currently out of stock.\\n\\nWould you like us to notify you when it's back, or see similar sarees?`;\n  }\n}\n\nreturn [{\n  json: {\n    chatId: parsed.chatId,\n    replyMessage\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[848,-144],"id":"a9d9a978-2636-4bc9-9534-254d9e4ffeac","name":"Check stock & build reply"},{"parameters":{"method":"POST","url":"https://platform.chatsyncs.com/api/v1/whatsapp/send","sendBody":true,"contentType":"form-urlencoded","bodyParameters":{"parameters":[{"name":"apiToken","value":"22152|m5XgWcJtPuXNiLqk01jg5AZ69mWOjp8CAT8Mk3o6bd4101bb"},{"name":"phone_number_id","value":"1041410149058121"},{"name":"phone_number","value":"={{ $json.chatId }}"},{"name":"message","value":"={{ $json.replyMessage }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1136,-144],"id":"5e3046b0-c603-4c77-99d6-16594e381d3d","name":"Send WhatsApp reply"},{"parameters":{"httpMethod":"POST","path":"chatsyncs-msg","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-64,-144],"id":"92b9